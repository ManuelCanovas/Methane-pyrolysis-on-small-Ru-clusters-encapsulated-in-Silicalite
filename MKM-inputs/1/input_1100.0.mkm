############################################################################################
# Example: input for CH4 methanation CH4 into C2+ gases and H2.
# Approximations: without lateral interactions, no difussions (one type of site),
# including tunnelling corrections, scaling some rates, only monodentates adsorbed species
# 
# 5 gas species and 15 surface species and free sites (*).
#
############################################################################################
&compounds
#############################################################################################
# Name; isSite; Concentration  (isSite:0 gas or 1 adsorbed species)
############################################################################################
CH4;  		0;  1
H2;  		0;  0
C2H2;  		0;  0.0
C2H4;  		0;  0.0
C2H6;  		0;  0.0
C*; 		1; 	0.0
CH*; 		1; 	0.0
CH2*; 		1; 	0.0
CH3*; 		1; 	0.0
CH4*;    	1; 	0.0
H*; 		1; 	0.0
CH3CH3*; 	1; 	0.0
CH3CH2*; 	1; 	0.0
CH2CH2*;	1; 	0.0
CH2CH*; 	1; 	0.0
CHCH*;		1; 	0.0
CHC*;	 	1; 	0.0
CH3CH*; 	1; 	0.0
CH3C*;	 	1; 	0.0
CH2C*; 		1; 	0.0
*;  		1; 	1.0  # Empty surface
############################################################################################
&reactions
############################################################################################
# (HK:Hertz-Knudsen, AR: Arrhenius)
#
#        elementary step             	    Af(s-1)	     Ab(s-1)    Eaf(J/mol) Eab(J/mol) DRC
#
############################################################################################
AR;	 {CH4} + {*} => {CH4*};	2.267e+08;	5.897e+14;	0.000;	60785.550;	   1

AR;	 2{H*} => {H2} + 2{*};	7.874e+14;	6.390e+08;	146332.221;	0.000;	   1

AR;	 {CH3*} + {H*} => {CH2*} + {H2} + {*};	7.911e+11;	1.198e+06;	153114.644;	0.000;	   1

AR;	 {CH2*} + {H*} => {CH*} + {H2} + {*};	2.244e+12;	1.198e+06;	144603.566;	0.000;	   1

AR;	 {CH*} + {H*} => {C*} + {H2} + {*};	1.069e+14;	9.006e+07;	132254.125;	49126.827;	   1

AR;	 {CH3CH3*} => {C2H6} + {*};	3.154e+13;	1.656e+08;	35899.185;	0.000;	   1

AR;	 {CH2CH2*} => {C2H4} + {*};	9.749e+15;	1.715e+08;	208602.278;	0.000;	   1

AR;	 {CHCH*} => {C2H2} + {*};	8.764e+15;	1.780e+08;	268158.338;	0.000;	   1

AR;	 {CH4*} + {*} => {CH3*} + {H*};	2.292e+13;	1.769e+13;	0.000;	60785.550;	   1

AR;	 {CH3*} + {*} => {CH2*} + {H*};	1.561e+13;	2.175e+13;	71337.702;	74232.252;	   1

AR;	 {CH2*} + {*} => {CH*} + {H*};	2.469e+13;	3.184e+13;	57891.000;	92625.600;	   1

AR;	 {CH*} + {*}  => {C*} + {H*};	2.110e+13;	1.383e+13;	85871.650;	132184.450;	   1

AR;	 {CH3*} + {CH3*} => {CH3CH3*} + {*};	3.539e+11;	4.116e+10;	176949.061;	51139.923;	   1

AR;	 {CH3*} + {CH2*} => {CH3CH2*} + {*};	2.110e+13;	9.624e+13;	168704.147;	133331.688;	   1

AR;	 {CH3CH2*} + {H*} => {CH3CH3*} + {*};	2.292e+13;	2.607e+11;	96616.648;	0.000;	   1

AR;	 {CH2*} + {CH2*} => {CH2CH2*} + {*};	5.304e+12;	9.908e+12;	201341.460;	245770.211;	   1

AR;	 {CH2*} + {CH*} => {CH2CH*} + {*};	4.561e+12;	6.480e+12;	91166.441;	142044.001;	   1

AR;	 {CH2CH*} + {H*} => {CH2CH2*} + {*};	5.713e+12;	2.987e+13;	132926.045;	179711.730;	   1

AR;	 {CH*} + {CH*} => {CHCH*} + {*};	4.141e+12;	2.636e+13;	171158.561;	265639.396;	   1

AR;	 {CH*} + {C*} => {CHC*} + {*};	2.584e+13;	5.244e+13;	80311.189;	123996.146;	   1

AR;	 {CHC*} + {H*}  => {CHCH*} + {*};	2.933e+12;	1.792e+13;	92574.755;	141122.661;	   1

AR;	 {CH3*} + {C*}  => {CH3C*} + {*};	5.157e+12;	3.560e+13;	181428.460;	198742.413;	   1

AR;	 {CH3*} + {CH*} => {CH3CH*} + {*};	3.798e+12;	5.565e+12;	151401.391;	125857.559;	   1

AR;	 {CH2*} + {C*}  => {CH2C*} + {*};	6.981e+12;	3.776e+12;	81669.067;	135762.351;	   1

AR;	 {CH3C*} + {H*} => {CH3CH*} + {*};	7.457e+12;	9.671e+12;	28473.718;	3544.060;	   1

AR;	 {CH3CH*} + {H*} => {CH3CH2*} + {*};	9.835e+12;	1.141e+13;	136783.640;	94487.871;	   1

AR;	 {CH2C*} + {H*} => {CH2CH*} + {*};	1.009e+12;	3.735e+12;	136207.081;	60441.148;	   1

############################################################################################
&settings
TYPE = SEQUENCERUN
# Specify overall pressure (bar)
PRESSURE = 1.0

#Debug statements from 0 (no debugging) to 4 (various leves of debug statements)
DEBUG = 1

# Specify REAGENTS here for reaction orders
 REAGENTS = {CH4}

 
# Specify key components for Eapp and DRC
  KEYCOMPONENTS = {C2H2}

# Perform degree of control analysis (0 or 1)
DRC = 1
#
#################################################################
&runs
#
# Temp (K);	Time (s); AbsTol (1e-8);	RelTol (1e-12)
1100.0;	     2e6;	         1e-20;	        1e-10

#################################################################
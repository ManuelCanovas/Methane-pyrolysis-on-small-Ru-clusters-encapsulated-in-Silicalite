############################################################################################
# Example: input for CH4 methanation CH4 into C2+ gases and H2.
# Approximations: without lateral interactions, no difussions (one type of site),
# including tunnelling corrections, scaling some rates, only monodentates adsorbed species
# 
# 5 gas species and 15 surface species and free sites (*).
#
############################################################################################
&compounds
#############################################################################################
# Name; isSite; Concentration  (isSite:0 gas or 1 adsorbed species)
############################################################################################
CH4;  		0;  1
H2;  		0;  0
C2H2;  		0;  0.0
C2H4;  		0;  0.0
C2H6;  		0;  0.0
C*; 		1; 	0.0
CH*; 		1; 	0.0
CH2*; 		1; 	0.0
CH3*; 		1; 	0.0
CH4*;    	1; 	0.0
H*; 		1; 	0.0
CH3CH3*; 	1; 	0.0
CH3CH2*; 	1; 	0.0
CH2CH2*;	1; 	0.0
CH2CH*; 	1; 	0.0
CHCH*;		1; 	0.0
CHC*;	 	1; 	0.0
CH3CH*; 	1; 	0.0
CH3C*;	 	1; 	0.0
CH2C*; 		1; 	0.0
*;  		1; 	1.0  # Empty surface
############################################################################################
&reactions
############################################################################################
# (HK:Hertz-Knudsen, AR: Arrhenius)
#
#        elementary step             	    Af(s-1)	     Ab(s-1)    Eaf(J/mol) Eab(J/mol) DRC
#
############################################################################################
AR;	 {CH4} + {*} => {CH4*};	9.033e+08;	1.131e+13;	0.000;	23651.020;	   1

AR;	 2{H*} => {H2} + 2{*};	2.009e+15;	2.546e+09;	78134.836;	0.000;	   1

AR;	 {CH3*} + {H*} => {CH2*} + {H2} + {*};	6.394e+11;	8.715e+06;	113530.439;	59753.816;	   1

AR;	 {CH2*} + {H*} => {CH*} + {H2} + {*};	1.702e+13;	2.799e+07;	177666.049;	104524.308;	   1

AR;	 {CH*} + {H*} => {C*} + {H2} + {*};	3.423e+15;	2.546e+09;	199578.266;	0.000;	   1

AR;	 {CH3CH3*} => {C2H6} + {*};	2.653e+14;	6.598e+08;	41684.783;	0.000;	   1

AR;	 {CH2CH2*} => {C2H4} + {*};	1.276e+16;	6.831e+08;	95922.261;	0.000;	   1

AR;	 {CHCH*} => {C2H2} + {*};	5.386e+16;	7.090e+08;	204358.251;	0.000;	   1

AR;	 {CH4*} + {*} => {CH3*} + {H*};	1.299e+11;	5.573e+12;	49762.404;	73064.089;	   1

AR;	 {CH3*} + {*} => {CH2*} + {H*};	1.703e+12;	1.716e+13;	63012.491;	59796.495;	   1

AR;	 {CH2*} + {*} => {CH*} + {H*};	1.039e+13;	1.515e+13;	70371.473;	91088.752;	   1

AR;	 {CH*} + {*}  => {C*} + {H*};	5.146e+13;	4.344e+13;	105026.632;	80813.798;	   1

AR;	 {CH3*} + {CH3*} => {CH3CH3*} + {*};	2.119e+13;	4.586e+11;	182394.816;	220125.699;	   1

AR;	 {CH3*} + {CH2*} => {CH3CH2*} + {*};	1.418e+13;	1.407e+13;	87383.636;	102029.021;	   1

AR;	 {CH3CH2*} + {H*} => {CH3CH3*} + {*};	3.132e+13;	1.475e+12;	73600.150;	67069.774;	   1

AR;	 {CH2*} + {CH2*} => {CH2CH2*} + {*};	4.094e+12;	4.922e+11;	35034.261;	102021.240;	   1

AR;	 {CH2*} + {CH*} => {CH2CH*} + {*};	7.967e+12;	1.989e+12;	59998.489;	199714.517;	   1

AR;	 {CH2CH*} + {H*} => {CH2CH2*} + {*};	4.384e+12;	5.232e+12;	42958.030;	61183.701;	   1

AR;	 {CH*} + {CH*} => {CHCH*} + {*};	2.292e+13;	7.651e+13;	0.000;	213617.460;	   1

AR;	 {CH*} + {C*} => {CHC*} + {*};	4.594e+13;	1.019e+13;	167448.585;	212156.341;	   1

AR;	 {CHC*} + {H*}  => {CHCH*} + {*};	1.340e+13;	1.798e+14;	87279.747;	152589.217;	   1

AR;	 {CH3*} + {C*}  => {CH3C*} + {*};	1.325e+13;	1.632e+13;	203058.483;	157244.517;	   1

AR;	 {CH3*} + {CH*} => {CH3CH*} + {*};	4.812e+12;	1.400e+12;	224587.257;	125756.766;	   1

AR;	 {CH2*} + {C*}  => {CH2C*} + {*};	1.969e+13;	7.710e+11;	191989.445;	115688.946;	   1

AR;	 {CH3C*} + {H*} => {CH3CH*} + {*};	7.390e+12;	1.875e+12;	117062.471;	132592.826;	   1

AR;	 {CH3CH*} + {H*} => {CH3CH2*} + {*};	2.523e+13;	2.387e+13;	62117.624;	80387.900;	   1

AR;	 {CH2C*} + {H*} => {CH2CH*} + {*};	7.022e+12;	1.345e+12;	88797.792;	29805.187;	   1

############################################################################################
&settings
TYPE = SEQUENCERUN
# Specify overall pressure (bar)
PRESSURE = 1.0

#Debug statements from 0 (no debugging) to 4 (various leves of debug statements)
DEBUG = 1

# Specify REAGENTS here for reaction orders
 REAGENTS = {CH4}

 
# Specify key components for Eapp and DRC
  KEYCOMPONENTS = {C2H2}

# Perform degree of control analysis (0 or 1)
DRC = 1
#
#################################################################
&runs
#
# Temp (K);	Time (s); AbsTol (1e-8);	RelTol (1e-12)
1100.0;	     2e6;	         1e-20;	        1e-10

#################################################################
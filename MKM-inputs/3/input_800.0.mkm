############################################################################################
# Example: input for CH4 methanation CH4 into C2+ gases and H2.
# Approximations: without lateral interactions, no difussions (one type of site),
# including tunnelling corrections, scaling some rates, only monodentates adsorbed species
# 
# 5 gas species and 15 surface species and free sites (*).
#
############################################################################################
&compounds
#############################################################################################
# Name; isSite; Concentration  (isSite:0 gas or 1 adsorbed species)
############################################################################################
CH4;  		0;  1
H2;  		0;  0
C2H2;  		0;  0.0
C2H4;  		0;  0.0
C2H6;  		0;  0.0
C*; 		1; 	0.0
CH*; 		1; 	0.0
CH2*; 		1; 	0.0
CH3*; 		1; 	0.0
CH4*;    	1; 	0.0
H*; 		1; 	0.0
CH3CH3*; 	1; 	0.0
CH3CH2*; 	1; 	0.0
CH2CH2*;	1; 	0.0
CH2CH*; 	1; 	0.0
CHCH*;		1; 	0.0
CHC*;	 	1; 	0.0
CH3CH*; 	1; 	0.0
CH3C*;	 	1; 	0.0
CH2C*; 		1; 	0.0
*;  		1; 	1.0  # Empty surface
############################################################################################
&reactions
############################################################################################
# (HK:Hertz-Knudsen, AR: Arrhenius)
#
#        elementary step             	    Af(s-1)	     Ab(s-1)    Eaf(J/mol) Eab(J/mol) DRC
#
############################################################################################
AR;	 {CH4} + {*} => {CH4*};	1.059e+09;	2.256e+13;	0.000;	23651.020;	   1

AR;	 2{H*} => {H2} + 2{*};	1.976e+15;	2.985e+09;	78134.836;	0.000;	   1

AR;	 {CH3*} + {H*} => {CH2*} + {H2} + {*};	6.558e+11;	1.075e+07;	113530.439;	59753.816;	   1

AR;	 {CH2*} + {H*} => {CH*} + {H2} + {*};	1.217e+13;	2.558e+07;	177666.049;	104524.308;	   1

AR;	 {CH*} + {H*} => {C*} + {H2} + {*};	2.955e+15;	2.985e+09;	199578.266;	0.000;	   1

AR;	 {CH3CH3*} => {C2H6} + {*};	5.393e+14;	7.737e+08;	41684.783;	0.000;	   1

AR;	 {CH2CH2*} => {C2H4} + {*};	2.335e+16;	8.010e+08;	95922.261;	0.000;	   1

AR;	 {CHCH*} => {C2H2} + {*};	7.295e+16;	8.314e+08;	204358.251;	0.000;	   1

AR;	 {CH4*} + {*} => {CH3*} + {H*};	1.313e+11;	5.760e+12;	49762.404;	73064.089;	   1

AR;	 {CH3*} + {*} => {CH2*} + {H*};	1.444e+12;	1.529e+13;	63012.491;	59796.495;	   1

AR;	 {CH2*} + {*} => {CH*} + {H*};	8.895e+12;	1.356e+13;	70371.473;	91088.752;	   1

AR;	 {CH*} + {*}  => {C*} + {H*};	3.784e+13;	3.490e+13;	105026.632;	80813.798;	   1

AR;	 {CH3*} + {CH3*} => {CH3CH3*} + {*};	2.015e+13;	3.789e+11;	182394.816;	220125.699;	   1

AR;	 {CH3*} + {CH2*} => {CH3CH2*} + {*};	1.137e+13;	9.220e+12;	87383.636;	102029.021;	   1

AR;	 {CH3CH2*} + {H*} => {CH3CH3*} + {*};	2.860e+13;	1.242e+12;	73600.150;	67069.774;	   1

AR;	 {CH2*} + {CH2*} => {CH2CH2*} + {*};	4.096e+12;	4.575e+11;	35034.261;	102021.240;	   1

AR;	 {CH2*} + {CH*} => {CH2CH*} + {*};	7.781e+12;	1.635e+12;	59998.489;	199714.517;	   1

AR;	 {CH2CH*} + {H*} => {CH2CH2*} + {*};	4.432e+12;	4.771e+12;	42958.030;	61183.701;	   1

AR;	 {CH*} + {CH*} => {CHCH*} + {*};	1.667e+13;	4.865e+13;	0.000;	213617.460;	   1

AR;	 {CH*} + {C*} => {CHC*} + {*};	3.252e+13;	7.722e+12;	167448.585;	212156.341;	   1

AR;	 {CHC*} + {H*}  => {CHCH*} + {*};	1.163e+13;	1.226e+14;	87279.747;	152589.217;	   1

AR;	 {CH3*} + {C*}  => {CH3C*} + {*};	1.199e+13;	1.268e+13;	203058.483;	157244.517;	   1

AR;	 {CH3*} + {CH*} => {CH3CH*} + {*};	4.774e+12;	1.252e+12;	224587.257;	125756.766;	   1

AR;	 {CH2*} + {C*}  => {CH2C*} + {*};	1.688e+13;	7.655e+11;	191989.445;	115688.946;	   1

AR;	 {CH3C*} + {H*} => {CH3CH*} + {*};	6.999e+12;	1.710e+12;	117062.471;	132592.826;	   1

AR;	 {CH3CH*} + {H*} => {CH3CH2*} + {*};	2.085e+13;	1.638e+13;	62117.624;	80387.900;	   1

AR;	 {CH2C*} + {H*} => {CH2CH*} + {*};	6.722e+12;	1.143e+12;	88797.792;	29805.187;	   1

############################################################################################
&settings
TYPE = SEQUENCERUN
# Specify overall pressure (bar)
PRESSURE = 1.0

#Debug statements from 0 (no debugging) to 4 (various leves of debug statements)
DEBUG = 1

# Specify REAGENTS here for reaction orders
 REAGENTS = {CH4}

 
# Specify key components for Eapp and DRC
  KEYCOMPONENTS = {C2H2}

# Perform degree of control analysis (0 or 1)
DRC = 1
#
#################################################################
&runs
#
# Temp (K);	Time (s); AbsTol (1e-8);	RelTol (1e-12)
800.0;	     2e6;	         1e-20;	        1e-10

#################################################################
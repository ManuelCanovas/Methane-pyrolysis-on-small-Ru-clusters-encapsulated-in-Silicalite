############################################################################################
# Example: input for CH4 methanation CH4 into C2+ gases and H2.
# Approximations: without lateral interactions, no difussions (one type of site),
# including tunnelling corrections, scaling some rates, only monodentates adsorbed species
# 
# 5 gas species and 15 surface species and free sites (*).
#
############################################################################################
&compounds
#############################################################################################
# Name; isSite; Concentration  (isSite:0 gas or 1 adsorbed species)
############################################################################################
CH4;  		0;  1
H2;  		0;  0
C2H2;  		0;  0.0
C2H4;  		0;  0.0
C2H6;  		0;  0.0
C*; 		1; 	0.0
CH*; 		1; 	0.0
CH2*; 		1; 	0.0
CH3*; 		1; 	0.0
CH4*;    	1; 	0.0
H*; 		1; 	0.0
CH3CH3*; 	1; 	0.0
CH3CH2*; 	1; 	0.0
CH2CH2*;	1; 	0.0
CH2CH*; 	1; 	0.0
CHCH*;		1; 	0.0
CHC*;	 	1; 	0.0
CH3CH*; 	1; 	0.0
CH3C*;	 	1; 	0.0
CH2C*; 		1; 	0.0
*;  		1; 	1.0  # Empty surface
############################################################################################
&reactions
############################################################################################
# (HK:Hertz-Knudsen, AR: Arrhenius)
#
#        elementary step             	    Af(s-1)	     Ab(s-1)    Eaf(J/mol) Eab(J/mol) DRC
#
############################################################################################
AR;	 {CH4} + {*} => {CH4*};	1.497e+09;	1.721e+13;	0.000;	50887.634;	   1

AR;	 2{H*} => {H2} + 2{*};	4.406e+15;	4.219e+09;	118544.504;	0.000;	   1

AR;	 {CH3*} + {H*} => {CH2*} + {H2} + {*};	6.335e+11;	2.149e+07;	244340.291;	144627.635;	   1

AR;	 {CH2*} + {H*} => {CH*} + {H2} + {*};	6.020e+13;	6.557e+07;	172556.499;	105313.836;	   1

AR;	 {CH*} + {H*} => {C*} + {H2} + {*};	1.139e+14;	4.484e+07;	193342.923;	60400.832;	   1

AR;	 {CH3CH3*} => {C2H6} + {*};	1.277e+15;	1.093e+09;	60504.803;	0.000;	   1

AR;	 {CH2CH2*} => {C2H4} + {*};	3.078e+17;	1.132e+09;	187949.449;	0.000;	   1

AR;	 {CHCH*} => {C2H2} + {*};	2.519e+17;	1.175e+09;	258370.815;	0.000;	   1

AR;	 {CH4*} + {*} => {CH3*} + {H*};	3.078e+10;	1.707e+12;	46413.677;	109503.079;	   1

AR;	 {CH3*} + {*} => {CH2*} + {H*};	1.565e+12;	1.685e+13;	90784.579;	63826.593;	   1

AR;	 {CH2*} + {*} => {CH*} + {H*};	1.930e+13;	3.347e+13;	45433.285;	23065.075;	   1

AR;	 {CH*} + {*}  => {C*} + {H*};	3.921e+13;	2.421e+13;	119583.209;	53116.196;	   1

AR;	 {CH3*} + {CH3*} => {CH3CH3*} + {*};	1.177e+13;	1.494e+11;	254924.469;	240250.125;	   1

AR;	 {CH3*} + {CH2*} => {CH3CH2*} + {*};	8.396e+13;	3.083e+13;	160492.191;	163793.872;	   1

AR;	 {CH3CH2*} + {H*} => {CH3CH3*} + {*};	1.663e+13;	9.494e+11;	191475.046;	118568.658;	   1

AR;	 {CH2*} + {CH2*} => {CH2CH2*} + {*};	3.745e+12;	6.540e+12;	131776.332;	209606.826;	   1

AR;	 {CH2*} + {CH*} => {CH2CH*} + {*};	1.117e+13;	1.874e+12;	241942.323;	300269.026;	   1

AR;	 {CH2CH*} + {H*} => {CH2CH2*} + {*};	6.361e+11;	7.488e+12;	152871.918;	181373.932;	   1

AR;	 {CH*} + {CH*} => {CHCH*} + {*};	1.078e+13;	2.004e+13;	112811.419;	242082.119;	   1

AR;	 {CH*} + {C*} => {CHC*} + {*};	7.758e+12;	5.703e+11;	137927.340;	168299.010;	   1

AR;	 {CHC*} + {H*}  => {CHCH*} + {*};	2.092e+12;	6.673e+13;	33833.226;	118916.304;	   1

AR;	 {CH3*} + {C*}  => {CH3C*} + {*};	2.057e+13;	6.145e+12;	216929.264;	221678.638;	   1

AR;	 {CH3*} + {CH*} => {CH3CH*} + {*};	5.842e+12;	2.798e+12;	98361.971;	60363.817;	   1

AR;	 {CH2*} + {C*}  => {CH2C*} + {*};	6.667e+12;	1.705e+12;	58874.408;	86206.983;	   1

AR;	 {CH3C*} + {H*} => {CH3CH*} + {*};	2.970e+12;	2.981e+12;	151090.271;	161712.548;	   1

AR;	 {CH3CH*} + {H*} => {CH3CH2*} + {*};	7.020e+12;	1.747e+13;	76618.168;	111659.255;	   1

AR;	 {CH2C*} + {H*} => {CH2CH*} + {*};	1.576e+13;	1.136e+13;	81107.753;	102581.053;	   1

############################################################################################
&settings
TYPE = SEQUENCERUN
# Specify overall pressure (bar)
PRESSURE = 1.0

#Debug statements from 0 (no debugging) to 4 (various leves of debug statements)
DEBUG = 1

# Specify REAGENTS here for reaction orders
 REAGENTS = {CH4}

 
# Specify key components for Eapp and DRC
  KEYCOMPONENTS = {C2H2}

# Perform degree of control analysis (0 or 1)
DRC = 1
#
#################################################################
&runs
#
# Temp (K);	Time (s); AbsTol (1e-8);	RelTol (1e-12)
1000.0;	     2e6;	         1e-20;	        1e-10

#################################################################
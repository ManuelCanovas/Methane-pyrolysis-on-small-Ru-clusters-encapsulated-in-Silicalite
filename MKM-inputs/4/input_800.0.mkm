############################################################################################
# Example: input for CH4 methanation CH4 into C2+ gases and H2.
# Approximations: without lateral interactions, no difussions (one type of site),
# including tunnelling corrections, scaling some rates, only monodentates adsorbed species
# 
# 5 gas species and 15 surface species and free sites (*).
#
############################################################################################
&compounds
#############################################################################################
# Name; isSite; Concentration  (isSite:0 gas or 1 adsorbed species)
############################################################################################
CH4;  		0;  1
H2;  		0;  0
C2H2;  		0;  0.0
C2H4;  		0;  0.0
C2H6;  		0;  0.0
C*; 		1; 	0.0
CH*; 		1; 	0.0
CH2*; 		1; 	0.0
CH3*; 		1; 	0.0
CH4*;    	1; 	0.0
H*; 		1; 	0.0
CH3CH3*; 	1; 	0.0
CH3CH2*; 	1; 	0.0
CH2CH2*;	1; 	0.0
CH2CH*; 	1; 	0.0
CHCH*;		1; 	0.0
CHC*;	 	1; 	0.0
CH3CH*; 	1; 	0.0
CH3C*;	 	1; 	0.0
CH2C*; 		1; 	0.0
*;  		1; 	1.0  # Empty surface
############################################################################################
&reactions
############################################################################################
# (HK:Hertz-Knudsen, AR: Arrhenius)
#
#        elementary step             	    Af(s-1)	     Ab(s-1)    Eaf(J/mol) Eab(J/mol) DRC
#
############################################################################################
AR;	 {CH4} + {*} => {CH4*};	1.674e+09;	2.781e+13;	0.000;	50887.634;	   1

AR;	 2{H*} => {H2} + 2{*};	4.174e+15;	4.716e+09;	118544.504;	0.000;	   1

AR;	 {CH3*} + {H*} => {CH2*} + {H2} + {*};	6.761e+11;	2.552e+07;	244340.291;	144627.635;	   1

AR;	 {CH2*} + {H*} => {CH*} + {H2} + {*};	4.337e+13;	5.878e+07;	172556.499;	105313.836;	   1

AR;	 {CH*} + {H*} => {C*} + {H2} + {*};	8.001e+13;	4.210e+07;	193342.923;	60400.832;	   1

AR;	 {CH3CH3*} => {C2H6} + {*};	2.031e+15;	1.222e+09;	60504.803;	0.000;	   1

AR;	 {CH2CH2*} => {C2H4} + {*};	4.193e+17;	1.266e+09;	187949.449;	0.000;	   1

AR;	 {CHCH*} => {C2H2} + {*};	2.898e+17;	1.314e+09;	258370.815;	0.000;	   1

AR;	 {CH4*} + {*} => {CH3*} + {H*};	3.094e+10;	1.731e+12;	46413.677;	109503.079;	   1

AR;	 {CH3*} + {*} => {CH2*} + {H*};	1.494e+12;	1.561e+13;	90784.579;	63826.593;	   1

AR;	 {CH2*} + {*} => {CH*} + {H*};	1.670e+13;	2.955e+13;	45433.285;	23065.075;	   1

AR;	 {CH*} + {*}  => {C*} + {H*};	3.333e+13;	2.203e+13;	119583.209;	53116.196;	   1

AR;	 {CH3*} + {CH3*} => {CH3CH3*} + {*};	1.090e+13;	1.301e+11;	254924.469;	240250.125;	   1

AR;	 {CH3*} + {CH2*} => {CH3CH2*} + {*};	6.871e+13;	2.254e+13;	160492.191;	163793.872;	   1

AR;	 {CH3CH2*} + {H*} => {CH3CH3*} + {*};	1.534e+13;	8.277e+11;	191475.046;	118568.658;	   1

AR;	 {CH2*} + {CH2*} => {CH2CH2*} + {*};	3.748e+12;	5.601e+12;	131776.332;	209606.826;	   1

AR;	 {CH2*} + {CH*} => {CH2CH*} + {*};	9.990e+12;	1.571e+12;	241942.323;	300269.026;	   1

AR;	 {CH2CH*} + {H*} => {CH2CH2*} + {*};	6.736e+11;	6.586e+12;	152871.918;	181373.932;	   1

AR;	 {CH*} + {CH*} => {CHCH*} + {*};	9.765e+12;	1.678e+13;	112811.419;	242082.119;	   1

AR;	 {CH*} + {C*} => {CHC*} + {*};	6.639e+12;	5.382e+11;	137927.340;	168299.010;	   1

AR;	 {CHC*} + {H*}  => {CHCH*} + {*};	2.042e+12;	5.211e+13;	33833.226;	118916.304;	   1

AR;	 {CH3*} + {C*}  => {CH3C*} + {*};	1.943e+13;	5.433e+12;	216929.264;	221678.638;	   1

AR;	 {CH3*} + {CH*} => {CH3CH*} + {*};	5.607e+12;	2.465e+12;	98361.971;	60363.817;	   1

AR;	 {CH2*} + {C*}  => {CH2C*} + {*};	6.497e+12;	1.619e+12;	58874.408;	86206.983;	   1

AR;	 {CH3C*} + {H*} => {CH3CH*} + {*};	2.908e+12;	2.717e+12;	151090.271;	161712.548;	   1

AR;	 {CH3CH*} + {H*} => {CH3CH2*} + {*};	6.323e+12;	1.380e+13;	76618.168;	111659.255;	   1

AR;	 {CH2C*} + {H*} => {CH2CH*} + {*};	1.466e+13;	9.459e+12;	81107.753;	102581.053;	   1

############################################################################################
&settings
TYPE = SEQUENCERUN
# Specify overall pressure (bar)
PRESSURE = 1.0

#Debug statements from 0 (no debugging) to 4 (various leves of debug statements)
DEBUG = 1

# Specify REAGENTS here for reaction orders
 REAGENTS = {CH4}

 
# Specify key components for Eapp and DRC
  KEYCOMPONENTS = {C2H2}

# Perform degree of control analysis (0 or 1)
DRC = 1
#
#################################################################
&runs
#
# Temp (K);	Time (s); AbsTol (1e-8);	RelTol (1e-12)
800.0;	     2e6;	         1e-20;	        1e-10

#################################################################